    },
    "bubble": {
      "value": "16px",
      "description": "锚定气泡"
    }
  },
  "typography": {
    "fontFamily": {
      "value": "\"SF Pro Display\", \"SF Pro Text\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", sans-serif"
    },
    "scale": {
      "title": {
        "value": {
          "fontSize": "17px",
          "weight": 600
        }
      },
      "body": {
        "value": {
          "fontSize": "14px",
          "weight": 400
        }
      },
      "label": {
        "value": {
          "fontSize": "12px",
          "weight": 500
        }
      },
      "caption": {
        "value": {
          "fontSize": "10.5px",
          "weight": 500
        }
      }
    }
  },
  "motion": {
    "easeSpring": {
      "value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "description": "弹簧回弹：弹出/吸附/选中（≈ damping 0.6）"
    },
    "easeGlass": {
      "value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "description": "玻璃滑入：面板浮现/悬浮过渡"
    },
    "duration": {
      "fast": {
        "value": "160ms",
        "description": "按压反馈/气泡消失"
      },
      "base": {
        "value": "280ms",
        "description": "气泡弹出/芯片切换"
      },
      "slow": {
        "value": "420ms",
        "description": "抽屉吸附/卡片展开"
      },
      "reveal": {
        "value": "700ms",
        "description": "页面首次浮现"
      }
    },
    "pressScale": {
      "value": 0.96,
      "description": "按压缩小反馈"
    },
    "dragDamping": {
      "value": {
        "up": 0.4,
        "down": 0.85,
        "fullCollapse": 0.82
      },
      "description": "底部抽屉拖拽阻尼（v3.8 实测值）"
    },
    "sheetSnap": {
      "value": {
        "expand": "-38px 或上滑速度>0.45px/ms",
        "close": "140px 或下甩>0.65px/ms",
        "peekFromFull": "90px"
      }
    },
    "aurora": {
      "value": "36s ease-in-out infinite alternate",
      "description": "L0 极光背景漂移周期"
    }
  },
  "layout": {
    "modalMaxWidth": {
      "value": "448px"
    },
    "sheetMaxHeight": {
      "value": "86vh",
      "description": "抽屉半屏态"
    },
    "safeBottom": {
      "value": "env(safe-area-inset-bottom)"
    },
    "mobileBreakpoint": {
      "value": "768px"
    },
    "thumbZone": {
      "value": "屏幕底部 30%",
      "description": "主操作按钮优先布置在拇指热区"
    }
