  "layer": {
    "zMap": {
      "value": 0,
      "description": "地图/底图"
    },
    "zLegend": {
      "value": 800,
      "description": "图例/小地图"
    },
    "zTabbar": {
      "value": 2000,
      "description": "底部导航"
    },
    "zModal": {
      "value": 2000,
      "description": "弹窗/抽屉"
    },
    "zEditPanel": {
      "value": 2100,
      "description": "编辑面板（必须高于 Tab 栏）"
    },
    "zPopover": {
      "value": 2600,
      "description": "锚定气泡（最高交互层）"
    },
    "zToast": {
      "value": 3000,
      "description": "全局提示"
    }
  },
  "accessibility": {
    "reducedMotion": {
      "value": "@media (prefers-reduced-motion: reduce) 禁用弹簧动画与拖拽动效，改为直接切换",
      "description": "已实现"
    },
    "darkMode": {
      "value": "[data-theme=dark] 108+ 条覆盖规则，玻璃底色 rgba(34,36,62,.86)，文字 #e8eaf6"
    },
    "contrast": {
      "value": "玻璃上的正文用 --color-text（#1c1c28），禁用 muted 做正文"
    }
  },
  "fx": {
    "v3.27-ningguang": {
      "glow-accent-rgb": "255, 122, 47",
      "contour-glow": "inset 0 0 0 1px rgba(255,255,255,.30), 0 10px 34px -10px rgba(255,122,47,.38)",
      "ripple-duration": "0.55s",
      "press-squish": "0.90~0.94 scale, 0.09s ease-out",
      "release-rebound": "0.4s~0.45s cubic-bezier(0.34, 1.56, 0.64, 1)",
      "pblur-cap-height": "30px",
      "pblur-max-blur": "14px"
    },
    "v3.29-monolith": {
      "cap-ink-light": "#111114",
      "cap-ink-dark": "#F2F2F3",
      "cap-surface-light": "rgba(255,255,255,.66)",
      "cap-surface-dark": "rgba(27,27,31,.78)",
      "cap-track": "#ECECF1 / #2F2F2F",
      "cap-thumb": "#FFFFFF / #3A3A40",
      "cap-hairline": "rgba(0,0,0,.08) / rgba(255,255,255,.10)",
      "brand-orange-kept-for": "logo icon, primary CTA, POI map accents",
      "reference": "design/design.md（墨石 Monolith）"
    }
  }
